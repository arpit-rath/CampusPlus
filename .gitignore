apps/web/tsconfig.tsbuildinfo

# Generated demo fixture. Regenerated in under a second by
# `python scripts/seed_demo.py`, and it stores a 768-float embedding per
# complaint (~270 KB) that is specific to whichever provider produced it —
# committing it would bloat every diff with numbers that mean nothing once
# the provider changes.
scripts/demo_data.json
