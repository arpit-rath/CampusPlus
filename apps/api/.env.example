# Postgres (matches docker-compose.yml defaults for local dev)
DATABASE_URL=postgresql+asyncpg://campuspulse:campuspulse@localhost:5432/campuspulse

# AI provider: "mock" needs nothing else and runs the whole pipeline against
# fake-but-realistic output. Switch to "gemini" once you have a free-tier key.
LLM_PROVIDER=mock
LLM_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Comma-separated origins allowed to call the API (the Next.js dev server by default)
CORS_ORIGINS=http://localhost:3000

# Recurring-cluster threshold — number of independent students before a
# cluster is flagged as a recurring problem
RECURRING_THRESHOLD=3
