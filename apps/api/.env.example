# Copy to apps/api/.env and fill in. NEVER commit a real .env — it is
# gitignored, and no key, password or token belongs anywhere in the repo.

# --- Database -------------------------------------------------------------
# Matches docker-compose.yml defaults for local dev. For a hosted Postgres
# (Supabase etc.) use its connection string with the +asyncpg driver:
#   postgresql+asyncpg://postgres:<password>@<host>:5432/postgres
DATABASE_URL=postgresql+asyncpg://campuspulse:campuspulse@localhost:5432/campuspulse

# --- AI provider ----------------------------------------------------------
# "mock" needs nothing else and runs the entire pipeline against
# fake-but-realistic structured output and embeddings. It is the dev default
# on purpose, so nobody burns Gemini quota on every keystroke.
# Switch to "gemini" and set LLM_API_KEY for the real thing.
LLM_PROVIDER=mock
LLM_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Hard ceiling on any single model call, in seconds.
LLM_TIMEOUT_SECONDS=20
# When true, a Gemini call that times out or errors transparently degrades
# to MockProvider instead of failing the request. Leave this on for a demo.
LLM_FALLBACK_TO_MOCK=true

# --- Similarity / clustering thresholds -----------------------------------
# Cosine similarity, scoped to same category + same building + rolling window.
#   >= DUPLICATE_THRESHOLD        -> auto-merge as a duplicate
#   >= SUGGESTED_MERGE_THRESHOLD  -> suggested merge, shown to an admin
#   below that                    -> a new, independent complaint
DUPLICATE_THRESHOLD=0.92
SUGGESTED_MERGE_THRESHOLD=0.75
SIMILARITY_WINDOW_DAYS=14
SIMILARITY_CANDIDATE_LIMIT=20
# Independent students (not submissions) before a cluster is recurring.
RECURRING_THRESHOLD=3

# --- Priority formula -----------------------------------------------------
# Cluster size at which the frequency term saturates, and the age at which
# the SLA term maxes out.
CLUSTER_CAP=20
SLA_SATURATION_HOURS=72

# --- Uploads --------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
PUBLIC_BASE_URL=http://localhost:8000

# --- Access control -------------------------------------------------------
# Leave empty and the admin API runs open (fine on a laptop; /health reports
# it as admin_auth: "disabled"). Set it and every /admin route plus status
# changes and deletes require the header `X-Admin-Token: <value>`.
ADMIN_TOKEN=

# Comma-separated origins allowed to call the API (the Next.js dev server).
CORS_ORIGINS=http://localhost:3000
